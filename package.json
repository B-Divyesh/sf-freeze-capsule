{
  "name": "freeze-capsule-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:site": "tsc --noEmit && vite build",
    "build": "npm run build:site",
    "preview": "vite preview --host 127.0.0.1",
    "test:rust": "cargo test",
    "test:site": "npm run build:site && playwright test",
    "test": "npm run test:rust && npm run test:site"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@types/node": "24.3.0",
    "@playwright/test": "1.58.2",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
